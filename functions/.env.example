# Copy to functions/.env.local for the emulator (never commit real secrets).
# Production: firebase functions:secrets:set SHOP_PIN_HASH
#             firebase functions:secrets:set GEMINI_API_KEY

# scrypt$<saltHex>$<digestHex>  — generate with: npm run hash-pin -- 1234
SHOP_PIN_HASH=

# debug | production
INTEGRITY_MODE=debug

# Required in production (Play Integrity / @expo/app-integrity)
CLOUD_PROJECT_NUMBER=

# Allowed Android package name
ANDROID_PACKAGE=com.babin78.myapp

# Gemini extract (F4 Check)
GEMINI_API_KEY=
# Optional override (default gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite
